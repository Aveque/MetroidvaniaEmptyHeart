--- !u!114 &505872166
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 505872164}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 18dfb422aea6a034fa823b7f516d749e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StationLoreNode
  Title: "\u041B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F / \u0440\u0430\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u043F\u0430\u043C\u044F\u0442\u0438"
  Message: "\u041F\u0440\u0438\u0432\u0438\u0432\u043A\u0430 31. \u0421\u043E\u0441\u0443\u0434\u0438\u0441\u0442\u0430\u044F
    \u0442\u043A\u0430\u043D\u044C \u043D\u0430\u0443\u0447\u0438\u043B\u0430\u0441\u044C
    \u0445\u0440\u0430\u043D\u0438\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u043E\u0432. \u041C\u044B \u043F\u043E\u043B\u0430\u0433\u0430\u043B\u0438,
    \u0447\u0442\u043E \u044D\u0442\u043E \u043F\u0430\u043C\u044F\u0442\u044C \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439.
    \u0422\u0435\u043F\u0435\u0440\u044C \u043A\u0430\u0436\u0434\u043E\u0435 \u043D\u043E\u0432\u043E\u0435
    \u0441\u0435\u043C\u044F \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0435\u0442
    \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0431\u0438\u0435\u043D\u0438\u0435
    \u0434\u043E\u043D\u043E\u0440\u0430.\n\n\u041C\u0430\u0442\u0435\u0440\u0438\u043D\u0441\u043A\u0438\u0439
    \u0443\u0437\u0435\u043B \u043D\u0435 \u0437\u0430\u0440\u0430\u0436\u0430\u0435\u0442
    \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0443. \u041E\u043D \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
    \u0435\u0451 \u0437\u0430 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0433\u043E
    \u0441\u0430\u0434\u043E\u0432\u043D\u0438\u043A\u0430. \u0417\u0430\u043F\u0440\u0435\u0442
    \u043D\u0430 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
    \u0432 \u043F\u0438\u0442\u043E\u043C\u043D\u0438\u043A \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043D
    \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0438
    \u0443\u0436\u0435 \u0443\u0448\u043B\u0438 \u0442\u0443\u0434\u0430 \u0432\u043E
    \u0432\u0442\u043E\u0440\u043E\u0439 \u0440\u0430\u0437."
