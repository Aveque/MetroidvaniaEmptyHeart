--- !u!114 &150104764
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 150104762}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 18dfb422aea6a034fa823b7f516d749e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StationLoreNode
  Title: "\u0421\u0435\u0440\u0434\u0446\u0435\u0432\u0438\u043D\u0430 / \u0436\u0438\u0432\u0430\u044F
    \u043C\u0430\u0433\u0438\u0441\u0442\u0440\u0430\u043B\u044C"
  Message: "\u041A\u043E\u0440\u043D\u0438 \u043D\u0435 \u0440\u043E\u0441\u043B\u0438
    \u043A \u0441\u0432\u0435\u0442\u0443. \u041E\u043D\u0438 \u0448\u043B\u0438
    \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u0443
    \u0438\u0437 \u0433\u043B\u0443\u0431\u0438\u043D\u044B. \u041E\u0442\u0441\u0442\u043E\u0439\u043D\u0438\u043A
    \u0431\u044B\u043B \u043F\u0435\u0440\u0432\u044B\u043C \u043C\u0435\u0441\u0442\u043E\u043C,
    \u0433\u0434\u0435 \u0432\u043E\u0434\u0430 \u043F\u043E\u0442\u0435\u043A\u043B\u0430
    \u0432\u0432\u0435\u0440\u0445.\n\n\u041C\u044B \u0441\u043D\u044F\u043B\u0438
    \u043F\u0438\u0442\u0430\u044E\u0449\u0438\u0439 \u043A\u043E\u043D\u0442\u0443\u0440,
    \u043D\u043E \u0441\u0430\u0434 \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F.
    \u0415\u0433\u043E \u043A\u043E\u0440\u043C\u0438\u0442 \u0447\u0442\u043E-\u0442\u043E
    \u043F\u043E \u0434\u0440\u0443\u0433\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443
    \u043C\u0430\u0433\u0438\u0441\u0442\u0440\u0430\u043B\u0438. \u0414\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0439
    \u043F\u0443\u0442\u044C \u043F\u043E\u043A\u0430 \u043D\u0435 \u043D\u0430\u043D\u0435\u0441\u0451\u043D
    \u043D\u0430 \u043A\u0430\u0440\u0442\u0443."
