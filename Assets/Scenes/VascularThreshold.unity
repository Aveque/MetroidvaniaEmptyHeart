--- !u!114 &1100511520
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1100511518}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 18dfb422aea6a034fa823b7f516d749e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StationLoreNode
  Title: "\u041E\u0440\u0430\u043D\u0436\u0435\u0440\u0435\u0438 / \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
    \u0443\u043A\u043E\u0440\u0435\u043D\u0435\u043D\u0438\u044F"
  Message: "\u0420\u0430\u0441\u0442\u0435\u043D\u0438\u044F \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0438
    \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u044C \u043E\u0447\u0438\u0449\u0435\u043D\u043D\u0443\u044E
    \u0432\u043E\u0434\u0443. \u041A\u043E\u0440\u043D\u0438 \u0438\u0449\u0443\u0442
    \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0449\u0443\u044E \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u044C
    \u0438 \u043E\u0431\u0440\u0430\u0441\u0442\u0430\u044E\u0442 \u0441\u0438\u0433\u043D\u0430\u043B\u044C\u043D\u044B\u043C\u0438
    \u043C\u0430\u0433\u0438\u0441\u0442\u0440\u0430\u043B\u044F\u043C\u0438. \u041C\u044B
    \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u043B\u0438 \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435,
    \u043D\u043E \u043A \u0443\u0442\u0440\u0443 \u0431\u0443\u0442\u043E\u043D\u044B
    \u0440\u0430\u0441\u043A\u0440\u044B\u043B\u0438\u0441\u044C \u0432 \u043F\u043E\u043B\u043D\u043E\u0439
    \u0442\u0435\u043C\u043D\u043E\u0442\u0435.\n\n\u041D\u0435 \u0441\u0440\u0435\u0437\u0430\u0439\u0442\u0435
    \u043C\u0435\u0434\u043D\u044B\u0435 \u043F\u043E\u0431\u0435\u0433\u0438: \u044D\u0442\u043E
    \u0443\u0436\u0435 \u043D\u0435 \u0442\u0440\u0443\u0431\u044B. \u0421\u0442\u0430\u043D\u0446\u0438\u044F
    \u043E\u0442\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u043A\u0430\u0436\u0434\u044B\u0439
    \u043D\u0430\u0434\u0440\u0435\u0437."
